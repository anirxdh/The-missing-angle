ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs is used for narration/character TTS and spoken-choice STT.

# Pruna AI — optional scene image generation
# Get key at: dashboard.pruna.ai (requires $5 credit minimum)
PRUNA_API_KEY=your_pruna_api_key_here

# Optional: pre-set voice IDs for characters
# Leave blank → defaults to ElevenLabs built-in voices
SARA_VOICE_ID=
COLE_VOICE_ID=
MAYA_VOICE_ID=
NARRATOR_VOICE_ID=

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs is used for narration, character TTS, spoken-choice STT,
# Speech Engine live interviews, and scene music beds (Music API).
# Groq supplies character responses.

# Optional: ElevenLabs Music model for static/music generation (default: music_v1)
# ELEVENLABS_MUSIC_MODEL=music_v1

# Speech Engine requires a persistent public WebSocket-capable FastAPI deployment.
# Example: https://your-service.onrender.com or a local ngrok HTTPS URL.
SPEECH_ENGINE_PUBLIC_URL=
SARA_SPEECH_ENGINE_ID=
MAYA_SPEECH_ENGINE_ID=
COLE_SPEECH_ENGINE_ID=

# Optional: pre-set voice IDs for characters
# Leave blank → defaults to ElevenLabs built-in voices
SARA_VOICE_ID=
COLE_VOICE_ID=
MAYA_VOICE_ID=
DANIEL_VOICE_ID=
NARRATOR_VOICE_ID=
TRAILER_NARRATOR_VOICE_ID=
